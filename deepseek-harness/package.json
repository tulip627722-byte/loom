{
  "name": "tulip-deepseek-harness-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local DeepSeek Harness deployment and customization workspace",
  "scripts": {
    "start": "node scripts/start.mjs",
    "serve": "node server/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.7": true,
    "koffi@3.1.5": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
